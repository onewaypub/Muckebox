#!/bin/sh
# SPDX-FileCopyrightText: 2026 Muckebox contributors
# SPDX-License-Identifier: AGPL-3.0-or-later
#
# Download a pinned gitleaks release into .tools/bin and verify its checksum.
set -eu

VERSION="8.30.1"
cd "$(dirname "$0")/.."
DEST=".tools/bin"
BIN="$DEST/gitleaks"

if [ -x "$BIN" ] && "$BIN" version 2>/dev/null | grep -q "$VERSION"; then
  exit 0
fi

case "$(uname -s)-$(uname -m)" in
  Linux-x86_64) PLATFORM="linux_x64" ;;
  Linux-aarch64) PLATFORM="linux_arm64" ;;
  Darwin-x86_64) PLATFORM="darwin_x64" ;;
  Darwin-arm64) PLATFORM="darwin_arm64" ;;
  *) echo "Unsupported platform for gitleaks download" >&2; exit 1 ;;
esac

BASE="https://github.com/gitleaks/gitleaks/releases/download/v$VERSION"
ARCHIVE="gitleaks_${VERSION}_${PLATFORM}.tar.gz"
TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT

curl -fsSL -o "$TMP/$ARCHIVE" "$BASE/$ARCHIVE"
curl -fsSL -o "$TMP/checksums.txt" "$BASE/gitleaks_${VERSION}_checksums.txt"
SHA256="sha256sum"
command -v sha256sum >/dev/null || SHA256="shasum -a 256"
(cd "$TMP" && grep " $ARCHIVE\$" checksums.txt | $SHA256 -c - >/dev/null)
tar -xzf "$TMP/$ARCHIVE" -C "$TMP" gitleaks
mkdir -p "$DEST"
mv "$TMP/gitleaks" "$BIN"
chmod +x "$BIN"
echo "Installed gitleaks $VERSION to $BIN"
