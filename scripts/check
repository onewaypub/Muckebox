#!/bin/sh
# SPDX-FileCopyrightText: 2026 Muckebox contributors
# SPDX-License-Identifier: AGPL-3.0-or-later
#
# Run every check that CI runs. Use it before each commit:
#   scripts/check          all checks
#   scripts/check --fast   skip the slower security audits (pip-audit)
set -eu

cd "$(dirname "$0")/.."
if [ -x .venv/bin/python ]; then
  PATH="$PWD/.venv/bin:$PATH"
fi

FAST=0
[ "${1:-}" = "--fast" ] && FAST=1

step() { printf '\n== %s\n' "$1"; }

step "ruff (lint)"
ruff check .

step "ruff (format)"
ruff format --check .

step "pytest (with coverage)"
MUCKEBOX_REQUIRE_GITLEAKS=1 pytest --cov --cov-report=term

step "bandit (static security analysis)"
bandit -q -c pyproject.toml -r muckebox

if [ "$FAST" -eq 0 ]; then
  step "pip-audit (known vulnerabilities in dependencies)"
  pip-audit --strict --require-hashes --disable-pip -r requirements.txt
fi

step "privacy scan (gitleaks)"
scripts/install-gitleaks
python scripts/privacy_scan.py

printf '\nAll checks passed.\n'
