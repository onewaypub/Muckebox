root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{js,mjs,css,html,json,yml,yaml,toml,md}]
indent_size = 2

[LICENSE]
indent_style = unset
indent_size = unset
